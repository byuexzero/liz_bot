# ==========================================================================
#  容器版 QQ 机器人的环境变量模板
# ==========================================================================
#  用法：cp deploy/.env.example deploy/.env，填入真实值。
#
#  deploy/.env 已被 .gitignore 的 `.env` 规则排除，不会入库。
#  （仓库根目录那个 .env 是给**本地保留**的 maimai/SDGB 工具链用的 ——
#   该工具链不随仓库分发，见 .gitignore；两者互不相干。）
#
#  这个文件由 deploy/docker-compose.yml 的 env_file 读取。
# ==========================================================================

# ---------- QQ 开放平台凭据（必填）----------
# 取自 QQ 开放平台 → 你的机器人 → 开发设置。
# ⚠️ AppSecret 等同于密码，泄漏后任何人都能顶替你的机器人上线。
QQ_BOT_APPID=
QQ_BOT_SECRET=

# ---------- 舞萌服务端 API 工具链（`#上传` 需要）----------
# 这 7 项是 `maimai/` 包的配置，**从仓库根目录的 .env 原样抄过来** ——
# 那份是本地跑工具链用的，两者内容应当一致。
#
# 为什么走环境变量而不是挂 .env 文件：`maimai/config.py` 读的是
# **项目根**的 .env（`_PROJECT_ROOT / ".env"`，容器里即 /app/.env），
# 而 compose 的 env_file 是把变量注入**环境**、不落地成文件 ——
# 正好是 `_load_dotenv` 找不到文件时走的那条路（`os.environ.get`）。
#
# ⚠️ 少了任何一项，`maimai.config` 会在 **import 期**抛 RuntimeError
#    （不是 ImportError，所以只接 ImportError 的探测会漏），
#    `#上传` 就回一句「Liz 现在还够不到 7sRef～」。
#
# ⚠️ 全部都是凭据：AES 密钥能伪造与官方服务器的通信，CHIP_ID 标识机台。
#    只进这个文件（已被 .gitignore 的 `.env` 规则排除），
#    **绝不入库、绝不上传任何平台**。
MAIMAI_AES_KEY=
MAIMAI_AES_IV=
MAIMAI_OBFUSCATE_PARAM=
CHIP_ID=
CLIENT_ID=
AIME_SALT=
AIME_AES_KEY_HEX=

# ---------- 运行时（一般不用改）----------
# 数据目录。compose 里已写死 /data，这里再写一遍是为了让直接
# `docker run` 跑（不经过 compose）时也有一致的行为。
LIZ_DATA_DIR=/data

# 健康检查端口。留空 = 不监听任何端口（裸机/本地开发的默认状态）。
HEALTHZ_PORT=8080

# 日志实时刷出，否则 docker logs 会攒在缓冲区里看不到。
PYTHONUNBUFFERED=1

# 时区。Dockerfile 里已设，这里重复一次是为了让 docker logs 的时间戳
# 在覆盖镜像默认值时也保持东八区。
TZ=Asia/Shanghai

# ---------- 构建期（只影响构建速度，不影响镜像内容）----------
# apt 源主机名。留空 = 用基础镜像自带的 Debian 官方源（deb.debian.org）。
#
# 在国内构建时**强烈建议**填上：Dockerfile 要装 build-essential，
# 从 Debian 官方源拉约 200MB 的 deb 包，可能慢到几十分钟。
# 腾讯云的公共镜像源，实测 /debian 与 /debian-security 都齐全：
#
#     APT_MIRROR=mirrors.cloud.tencent.com
#
# （在腾讯云实例上 `mirrors.tencentyun.com` 走内网、更快，可自行试。）
#
# 改完记得带 --build 重新构建才会生效。
APT_MIRROR=

# pip 的索引地址。留空 = pip 默认的 pypi.org。
#
# apt 拉完约 200MB 之后紧接着就是 pip 装 13 个依赖（约 40MB wheel），
# 国内直连 pypi.org 同样可能很慢。腾讯云的 PyPI 镜像，已核对本项目
# 全部直接依赖都在：
#
#     PIP_INDEX=https://mirrors.cloud.tencent.com/pypi/simple
#
# 同样只影响下载速度：版本约束由 requirements.txt 决定，换源不改变装什么。
# 万一某个传递依赖在该镜像上缺失，pip 会明确报 "No matching distribution"，
# 不会静默装错版本 —— 那时把这行清空重新构建即可。
PIP_INDEX=
