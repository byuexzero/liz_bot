# 统一换行符，避免 Windows 检出后产生无意义的整文件 diff。
# Git 在 Windows 上默认 core.autocrlf=true，会把 LF 改写成 CRLF，
# 导致每次检出都出现"整个文件被修改"的假 diff。
* text=auto eol=lf

# Windows 批处理必须用 CRLF，否则 cmd.exe 解析可能出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 注册表脚本同样按 CRLF 处理
*.reg text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.zlib binary
*.db binary
*.saz binary
*.exe binary
*.jar binary
*.so binary
*.dll binary
*.zip binary
