# ==========================================================================
#  maimai / SDGB 运行配置模板
# ==========================================================================
#  用法：复制本文件为 .env，填入真实值。
#      cp .env.example .env
#
#  .env 已被 .gitignore 排除，不会入库。
# ==========================================================================

# ---------- maimai 业务接口加密 ----------
# ⚠️ 版本号规则：从 1.00 起**每 +0.05 算一个大版本**，同一大版本
#    **共用同一套 key / IV / 混淆参数**：
#        1.40–1.44 ｜ 1.45–1.49 ｜ 1.50–1.54 ｜ 1.55–1.59 ｜ …
#    例外是**特殊更新**（目前只有 1.53 单独占一套）。
#    ⇒ 加密层：同一档内升版（如 1.55 → 1.56）key/IV/混淆参数都不用换。
#
# ⛔ **但 MAIMAI_ENCODING（= Mai-Encoding 请求头）不跟大版本桶走**：
#    服务端**只接受当前线上版本这一个值**。2026-09-25 实测（未登录裸调）：
#      1.50–1.54 → 响应 0 字节 ｜ **1.55 → 正常** ｜ 1.56–1.59 → 0 字节
#    连 "1.55.00" / "1.56.00" 这种带补丁号的写法也是 0 字节。
#    ⇒ 填错就是**所有接口一律空响应**（不是 404、不报错，极易误判成网络抖动）。
#    线上版本以 TITLE_VER（基板握手）为准，**两者必须一致**。
#
# 密钥随大版本变更。历史版本（来自 eaquira/encrypt.py 的注释存档）：
#   1.40（舞萌 DX 2024）  OBFUSCATE_PARAM=BEs2D5vW
#   1.50 ~ 1.52           OBFUSCATE_PARAM=B44df8yT
#   1.53（舞萌 DX 2025）  OBFUSCATE_PARAM=LatuAa81   ← 特殊更新，单独一套
#   1.55（舞萌 DX 2026）  ← 当前档位（1.55–1.59 共用）
#
# 1.55 的三个值**刻意不记录在本模板里**：它们来自网络来源的客户端反编译
# 产物，而本文件随仓库分发。已填在 .env（不入库），并在其中保留了 1.53 作为回退。
#
# ⚠️ 三个值必须与 MAIMAI_ENCODING **同属一个大版本**；跨档只换一两个
#    → 混淆名算错 → 请求全部失败（同档内升版则不需要换）。
MAIMAI_AES_KEY=
MAIMAI_AES_IV=
MAIMAI_OBFUSCATE_PARAM=
MAIMAI_ENCODING=1.55
# 数据版本，只用于 userData.lastDataVersion。
#
# 反编译源码里 lastRomVersion / lastDataVersion 是**两个独立配置**，且**都取
# 客户端自己的值**（不取服务端回传值）。本包只有 MAIMAI_ENCODING 一个版本来源，
# 所以：
#   * lastRomVersion  = MAIMAI_ENCODING 规范化成 "1.55.00"
#   * lastDataVersion = 本项；**留空则沿用服务端回传值**（通常形如 1.55.04）
# 只有在你确知机台的 dataVersion 时才需要填。
MAIMAI_DATA_VERSION=
# 中国版填 Chn，国际版填 Exp。该值会拼进混淆名：
#   md5(api + "Maimai" + MAIMAI_REGION + MAIMAI_OBFUSCATE_PARAM)
MAIMAI_REGION=Chn

# ---------- 基板 / 机台 ----------
# 基板 ID，形如 AAAA-BBBBBBBBBBB（含连字符）；
# CLIENT_ID 为去连字符后取前 11 位
CHIP_ID=
CLIENT_ID=
CODENAME=SDGB
# allnet / 基板握手的版本号，与 MAIMAI_ENCODING（游戏业务版本）分开。
# ⚠️ 当前无消费方：allnet 握手尚未实现，改此值暂时是惰性的。
TITLE_VER=1.55

# ---------- 服务端点 ----------
MAIMAI_BASE_URL=https://maimai-gm.wahlap.com:42081/Maimai2Servlet/
ALLNET_BASE_URL=http://at.sys-allnet.cn
AIME_QR_URL=http://ai.sys-allnet.cn/wc_aime/api/get_data

# ---------- A.I.M.E. 二维码接口 ----------
AIME_SALT=
# 16 字节密钥的十六进制形式（32 个 hex 字符）。
# 用 hex 而非明文，是因为该密钥含引号和反斜杠，直接写入 .env 易被误解析。
AIME_AES_KEY_HEX=

# ---------- 账号 ----------
# ⚠️ QR_CODE 是可直接上号的凭据，等同于账号密码，切勿外发。
#    二维码自带时间戳，通常有效期很短，需用新鲜二维码。
USER_ID=
QR_CODE=

# ---------- 机厅 ----------
REGION_ID=1
REGION_NAME=
PLACE_ID=
PLACE_NAME=

# ---------- 上传行为 ----------
# 是否额外发送独立的 UploadUserPlaylogApi。
# ⛔ 1.55 官方客户端**不发**这个接口：反编译树里三个调用点全部不可达
#    （PlaylogULProcess 从未被实例化；StateULUserAime / StateULUserGuest
#    里那个方法只被自己递归）。游玩记录只走 UpsertUserAllApi 顶层的
#    userPlaylogList（PacketUpsertUserAll 显式赋值）。
#    保持 false 以对齐官方行为；设为 1 可复现旧行为 / 做 A/B 排查。
MAIMAI_SEND_PLAYLOG=false

# ---------- 网络 ----------
# 留空 = 直连。支持 http:// 与 socks5://，形如 socks5://127.0.0.1:1100
PROXY_URL=
REQUEST_TIMEOUT=10
REQUEST_RETRIES=2
# 仅调试用，生产保持 false
INSECURE_TLS=false
